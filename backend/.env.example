# Application Configuration
PROJECT_NAME="GeM Bid Compliance Verification Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database Configuration (PostgreSQL / Supabase asyncpg URL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/gem_compliance_db"
